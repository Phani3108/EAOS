# ─────────────────────────────────────────────────────────────────────────────
# EAOS — Environment configuration (root)
#
# Every variable here is READ BY CODE. `packages/config` validates them on boot,
# prints a set/missing table, and exits 78 with a readable message if something
# required is absent — it no longer dies during module load with a bare stack
# trace. Booleans must be exactly "true" or "false"; anything else is rejected
# rather than coerced, because `ALLOW_ANON=yes` used to silently enable
# anonymous access.
#
# Removed from this file because NO CODE READS THEM:
#   GATEWAY_PORT   → the gateway reads PORT
#   WEB_PORT       → apps/web hardcodes --port 3010 in its package.json scripts
#   PERSISTENCE    → the store is selected by DATABASE_URL / DATA_DIR
#   POSTGRES_URL   → the code reads DATABASE_URL
#   GOOGLE_API_KEY → the Gemini provider reads GEMINI_API_KEY
#   OTEL_ENABLED   → OTel initialises whenever OTEL_EXPORTER_OTLP_ENDPOINT is set
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Interface the gateway listens on. Unset = every interface (what a container needs).
# `pnpm dev` sets 127.0.0.1 for both servers: local demo mode must not be reachable
# from the network.
HOST=
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=
# Full public URL of the gateway. Used to build OAuth redirect URIs.
GATEWAY_URL=http://localhost:3010/_/gateway

# Seeds a starter scenario into the memory graph on first boot.
# Defaults to FALSE. It previously defaulted to true, which is how production
# deployments ended up serving demo data nobody asked for.
SEED_DEMO=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# HMAC secret for signing JWTs. REQUIRED when NODE_ENV=production.
# Comma-separate to rotate: signs with the first, verifies against any.
#   openssl rand -base64 48
JWT_SECRET=
AUTH_SECRET=
API_KEY_HASH_SECRET=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
EAOS_TENANT_ID=default
FRONTEND_URL=http://localhost:3010
GATEWAY_INTERNAL_URL=http://127.0.0.1:3000

# Anonymous fallback. Opt-IN and defaults to FALSE (it used to default to true).
# Only enable this for isolated local fixtures, not normal interactive use.
# The browser UI authenticates through server-side sessions.
ALLOW_ANON=false

# Demo mode: off (default) | local | public.
#   local  — a request with no credential from THIS machine (loopback client, a
#            localhost Host, no foreign browser Origin) acts as ONE named local-demo
#            administrator, so the whole UI works with no sign-in. Anything else must
#            send a credential. `pnpm dev` sets this for you. Rejected under
#            NODE_ENV=production.
#   public — a hosted demo: visitors click "Try the demo" and get a private,
#            simulation-only session. Requires JWT_SECRET.
# Demo identities stop working when their mode is switched off: visitor sessions,
# and every session or key the local administrator minted.
EAOS_DEMO_MODE=local

# One-shot bootstrap token for POST /api/setup, which creates the first admin and
# then returns 410 forever. Min 32 chars.  openssl rand -hex 32
EAOS_SETUP_TOKEN=

# Comma-separated browser origins allowed to call the gateway.
# Unset in production means NO CORS header is sent (fail closed) — not "*".
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# Proxies whose X-Forwarded-For names the client: IP addresses or CIDR blocks,
# comma-separated. Unset trusts nobody. Unauthenticated calls (sign-in, demo, SSO)
# are rate limited per client; behind the web tier's /_/gateway proxy every visitor
# otherwise shares the web server's address. That shared case is budgeted for (the
# sign-in config is not limited; demo and SSO start allow 60/min for everyone), but
# per-client limits need this: list the web tier's address here when the proxy in
# front of it (any TLS terminator) sets X-Forwarded-For — the bundled proxy relays
# that header but does not add one, so without such an edge a client could name
# any address. `pnpm dev` trusts loopback.
EAOS_TRUSTED_PROXIES=

# 32-byte base64 key encrypting stored connector credentials at rest.
#   openssl rand -base64 32
EAOS_ENCRYPTION_KEY=

# ── Persistence ──────────────────────────────────────────────────────────────
# Set DATABASE_URL for Postgres. Required for >1 replica: the durable queue, the
# audit chain and per-tenant spend caps are only correct on Postgres.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Where the file-backed store writes when DATABASE_URL is unset. Must be
# writable. Defaults to ./.agentos-data, which is read-only on most PaaS hosts —
# set it explicitly there (e.g. /tmp/eaos-data) or use Postgres.
DATA_DIR=

# Data written before deployments were bound to a tenant is refused at boot unless
# it is this deployment's own: set true to bind it to EAOS_TENANT_ID (a single-
# tenant install upgrading in place). `pnpm dev` does this for its file store.
EAOS_ADOPT_LEGACY_DATA=

# Shared state across replicas: rate limits, spend caps, circuit breakers,
# OIDC login state, cross-replica events. Single replica works without it.
REDIS_URL=

# ── LLM providers ────────────────────────────────────────────────────────────
# With none of these set the gateway still boots, but any real run fails with
# LLMNotConfiguredError. It no longer returns placeholder prose and calls it a
# success. Explicitly simulated runs still work.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
OLLAMA_BASE_URL=

# ── Data handling ────────────────────────────────────────────────────────────
# Local-dev only: allows hash-derived embedding vectors so the memory service can
# run without an OpenAI key. Searchable, but NEVER stored — a persisted synthetic
# vector silently corrupts every future search in that namespace. Rejected in
# production.
MEMORY_ALLOW_SYNTHETIC_EMBEDDINGS=false

# Opt in to contributing anonymised run telemetry to cross-tenant benchmarks.
BENCHMARK_CONTRIBUTE=false

# Override the directory scanned for SKILL.md files.
EAOS_SKILLS_DIR=

# ── Connectors: GitHub ───────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ── Connectors: Jira ─────────────────────────────────────────────────────────
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Connectors: Slack ────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
# Incoming-webhook URL for execution.completed notifications.
SLACK_WEBHOOK_URL=
# OAuth (only needed if using the /oauth/callback flow)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Connectors: Google (Drive, GA4) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GA4_PROPERTY_ID=

# ── Connectors: HubSpot ──────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Connectors: LinkedIn Ads ─────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Connectors: Salesforce ───────────────────────────────────────────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_ACCESS_TOKEN=

# ── Connectors: WordPress / Perplexity ───────────────────────────────────────
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
PERPLEXITY_API_KEY=

# ── Observability ────────────────────────────────────────────────────────────
# OpenTelemetry export is enabled by the presence of this endpoint. Note the
# port: the exporter speaks OTLP over HTTP (4318), not gRPC (4317).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── MCP servers (Phase 0) — connected via mcp.servers.json when these are set ──
# Voicebox voice MCP server (HTTP). e.g. http://127.0.0.1:17493/mcp
VOICEBOX_URL=
# codebase-memory-mcp static binary path (stdio MCP server)
CODE_MEMORY_BIN=
CODE_MEMORY_DB=
# SkillSpector skill security scanner (stdio MCP server) — e.g. "skillspector"
SKILLSPECTOR_CMD=
