# ─────────────────────────────────────────────────────────────────────────────
# EAOS — environment for deploy/docker-compose.production.yml
#
#   cp deploy/.env.example deploy/.env      # deploy/.env is git-ignored
#   # fill in every blank value marked REQUIRED, then:
#   docker compose -f deploy/docker-compose.production.yml up -d
#
# Every variable here is read by that compose file, and nothing has a default
# password: compose refuses to start until each REQUIRED value is set. Generate
# every secret separately. Use hex — compose embeds the database and Redis
# passwords in connection URLs, where characters such as @ / : # would break them:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. Owner of the bundled `eaos` database. Used only to run migrations and
# to provision the gateway's login; the gateway itself never connects as the owner.
POSTGRES_PASSWORD=
# REQUIRED (16+ characters). Password of `eaos_app`, the separate non-owner login
# the gateway connects as. The app-role step creates it after migrations and
# grants it only what the gateway needs (deploy/postgres/app-role.sql). Production
# refuses to run the gateway as the owner, a superuser or a BYPASSRLS role.
EAOS_APP_DB_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED. Redis is not published on the host and requires this password.
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Signs every session token. Comma-separate to rotate: signs with the
# first, verifies against any.
JWT_SECRET=
# One-shot bootstrap token (24+ characters) for first-time administrator setup:
# open the web origin, choose "Go to Dashboard", then "First-time administrator
# setup", enter it, and save the API key shown once. Setup answers 410 once it has
# completed.
EAOS_SETUP_TOKEN=
# Hashes stored API keys. Set it before first startup and keep it unchanged: left
# blank, keys are hashed with JWT_SECRET, so rotating JWT_SECRET (or setting this
# later) invalidates every existing API key, the bootstrap admin key included.
API_KEY_HASH_SECRET=
EAOS_TENANT_ID=default

# ── Browser origin ───────────────────────────────────────────────────────────
# The public web origin. The browser reaches the gateway through the web app's
# same-origin /_/gateway proxy.
CORS_ALLOWED_ORIGINS=http://localhost:3010
FRONTEND_URL=http://localhost:3010
GATEWAY_URL=http://localhost:3010/_/gateway

# ── Organization single sign-on (optional) ───────────────────────────────────
# OIDC_REDIRECT_URI must be the web origin + /_/gateway/api/auth/oidc/callback.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ── LLM providers ────────────────────────────────────────────────────────────
# With none set, runs that do not choose a mode are simulated and labelled as
# such; a run that explicitly asks for live mode fails.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
COST_BUDGET_HOURLY_USD=50

# ── Connector credentials (optional) ─────────────────────────────────────────
# Vault KV v2 resolves connection secret references: an HTTPS origin plus token.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=

# ── Observability ────────────────────────────────────────────────────────────
# REQUIRED. Grafana admin password (Grafana listens on host port 3001).
GRAFANA_PASSWORD=
