{
    "name": "@agentos/gateway",
    "version": "0.1.0",
    "private": true,
    "description": "EOS Gateway — API server",
    "license": "MIT",
    "type": "module",
    "main": "src/server.ts",
    "exports": {
        ".": "./src/server.ts",
        "./persona-system": "./src/persona-system.ts",
        "./execution-api-contract": {
            "types": "./dist/execution-api-contract.d.ts",
            "import": "./dist/execution-api-contract.js"
        }
    },
    "scripts": {
        "dev": "EAOS_DEMO_MODE=${EAOS_DEMO_MODE:-local} npx tsx src/server.ts",
        "start": "node dist/server.js",
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@agentos/auth": "workspace:*",
        "@agentos/config": "workspace:*",
        "@agentos/connector-github": "workspace:*",
        "@agentos/connector-jira": "workspace:*",
        "@agentos/connector-slack": "workspace:*",
        "@agentos/db": "workspace:*",
        "@agentos/observability": "workspace:*",
        "@agentos/sandbox": "workspace:*",
        "@agentos/sdk": "workspace:*",
        "@agentos/secrets": "workspace:*",
        "@agentos/skills": "workspace:*",
        "@agentos/workflow-engine": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "ioredis": "^5.10.1",
        "yaml": "2.9.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "tsx": "^4.7.0",
        "typescript": "^5.4.0"
    }
}
