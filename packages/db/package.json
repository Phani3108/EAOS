{
    "name": "@agentos/db",
    "version": "0.1.0",
    "private": true,
    "description": "Database persistence layer — in-memory dev store + Postgres migrations",
    "license": "MIT",
    "type": "module",
    "main": "dist/connection.js",
    "exports": {
        ".": {
            "types": "./dist/connection.d.ts",
            "import": "./dist/connection.js"
        },
        "./persistent-store": {
            "types": "./dist/persistent-store.d.ts",
            "import": "./dist/persistent-store.js"
        },
        "./postgres-store": {
            "types": "./dist/postgres-store.d.ts",
            "import": "./dist/postgres-store.js"
        },
        "./unified-types": {
            "types": "./dist/unified-types.d.ts",
            "import": "./dist/unified-types.js"
        },
        "./run-repository": {
            "types": "./dist/run-repository.d.ts",
            "import": "./dist/run-repository.js"
        },
        "./schedule-repository": {
            "types": "./dist/schedule-repository.d.ts",
            "import": "./dist/schedule-repository.js"
        },
        "./platform-repository": {
            "types": "./dist/platform-repository.d.ts",
            "import": "./dist/platform-repository.js"
        },
        "./integration-repository": {
            "types": "./dist/integration-repository.d.ts",
            "import": "./dist/integration-repository.js"
        },
        "./workspace-repository": {
            "types": "./dist/workspace-repository.d.ts",
            "import": "./dist/workspace-repository.js"
        },
        "./workflow-store": {
            "types": "./dist/workflow-store.d.ts",
            "import": "./dist/workflow-store.js"
        },
        "./create-store": {
            "types": "./dist/create-store.d.ts",
            "import": "./dist/create-store.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "migrate": "node dist/migrate.js"
    },
    "devDependencies": {
        "@types/pg": "^8.11.0",
        "typescript": "^5.4.0"
    },
    "dependencies": {
        "@agentos/sdk": "workspace:*",
        "@agentos/skills": "workspace:*",
        "pg": "^8.13.0"
    }
}
